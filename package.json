{
  "name": "rw-file-manager",
  "productName": "RW File Manager",
  "version": "1.0.0",
  "description": "A modern desktop file manager built with Electron + React",
  "author": "bigmouthz <bigmouthz@163.com>",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:start": "electron .",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:5199 && VITE_DEV_SERVER_URL=http://localhost:5199 electron .\"",
    "electron:build": "vite build && electron-builder",
    "package": "vite build && electron-builder --mac"
  },
  "build": {
    "appId": "com.bigmouthz.rwfilemanager",
    "productName": "RW File Manager",
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities",
      "icon": "public/icon.icns"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*"
    ],
    "directories": {
      "buildResources": "assets"
    }
  },
  "dependencies": {
    "98.css": "^0.1.21",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "wait-on": "^9.0.5"
  }
}
